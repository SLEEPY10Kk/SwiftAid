# Copy to .env and fill in real values. .env is gitignored.
# Read by SwiftAid/app/build.gradle.kts via rootProject.file("../.env").

# Google OAuth web client ID (Google Cloud Console > Credentials)
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Base URL of the SwiftAid backend API
API_BASE_URL=http://192.168.x.x:8001

# LAN IP of the machine hosting the backend (used for on-device testing)
SERVER_IP=192.168.x.x
